PORT=8000

# Optional: deployed frontend origin allowed by CORS (localhost is always allowed)
FRONTEND_ORIGIN=

# LinkedIn (session-based, run `pnpm scrape:linkedin:login` once)
# Optional: fills in the login form for you (you still do 2FA/CAPTCHA in the browser)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_SEARCH_KEYWORDS="software engineer intern,data intern,ai intern,fintech intern,summer 2027 internship,software engineer summer 2027"
LINKEDIN_LOCATION="Singapore"
# Result pages per keyword (25 jobs each), and max new descriptions read per run
LINKEDIN_MAX_PAGES=2
LINKEDIN_MAX_DETAILS=60

# InternSG
INTERNSG_MAX_PAGES=6

# Career page discovery (free key at https://serper.dev)
SERPER_API_KEY=

# Telegram bot (phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
